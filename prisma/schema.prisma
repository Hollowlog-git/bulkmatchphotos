// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model DrawerRange {
  id           String   @id @default(cuid())
  shop         String
  drawerNumber Int
  startSku     String?
  endSku       String?
  updatedAt    DateTime @updatedAt

  @@unique([shop, drawerNumber])
}

model CustomerNote {
  id            String   @id @default(cuid())
  shop          String
  customerId    String?
  customerEmail String?
  customerName  String
  note          String
  archived      Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@index([shop, customerId])
  @@index([shop, customerEmail])
}

// Mirrors "ready to pack" parcels pushed from the local Trade Me ops app.
// This app never talks to Trade Me directly — the local app computes
// eligibility (payment, shipping, holds) itself and pushes the result here.
// A full-snapshot push replaces whatever was stored for a shop: any
// groupKey not present in the latest push is removed, so retracted orders
// (refunded, held, cancelled after the fact) disappear automatically.
model TradeMeJob {
  id                String   @id @default(cuid())
  shop              String
  groupKey          String
  buyerUsername     String?
  buyerMemberId     String?
  buyerName         String?
  buyerEmail        String?
  deliveryAddress   String?
  fulfilmentChannel String // "trademe" | "mixed"
  readiness         String?
  kanbanCol         String?
  itemCount         Int      @default(0)
  totalSale         Float    @default(0)
  shippingPaid      Float    @default(0)
  paidTotal         Float?
  lastSyncedAt      DateTime @updatedAt
  items             TradeMeJobItem[]

  @@unique([shop, groupKey])
  @@index([shop, buyerEmail])
}

model TradeMeJobItem {
  id            String     @id @default(cuid())
  job           TradeMeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String
  purchaseId    String     @unique
  listingId     String?
  sku           String?
  title         String?
  quantity      Int        @default(1)
  salePrice     Float      @default(0)
  shippingPrice Float      @default(0)
  soldDate      String?
  saleChannel   String? // "store" | "auction" | "fpo"
  packed        Boolean    @default(false)

  @@index([jobId])
}
