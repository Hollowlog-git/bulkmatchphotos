// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model DrawerRange {
  id           String   @id @default(cuid())
  shop         String
  drawerNumber Int
  startSku     String?
  endSku       String?
  updatedAt    DateTime @updatedAt

  @@unique([shop, drawerNumber])
}

model CustomerNote {
  id            String   @id @default(cuid())
  shop          String
  customerId    String?
  customerEmail String?
  customerName  String
  note          String
  archived      Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@index([shop, customerId])
  @@index([shop, customerEmail])
}

// Mirrors "ready to pack" parcels pushed from the local Trade Me ops app.
// This app never talks to Trade Me directly — the local app computes
// eligibility (payment, shipping, holds) itself and pushes the result here.
// A full-snapshot push replaces whatever was stored for a shop: any
// groupKey not present in the latest push is removed, so retracted orders
// (refunded, held, cancelled after the fact) disappear automatically.
model TradeMeJob {
  id                String   @id @default(cuid())
  shop              String
  groupKey          String
  buyerUsername     String?
  buyerMemberId     String?
  buyerName         String?
  buyerEmail        String?
  deliveryAddress   String?
  fulfilmentChannel String // "trademe" | "mixed"
  readiness         String?
  kanbanCol         String?
  itemCount         Int      @default(0)
  totalSale         Float    @default(0)
  shippingPaid      Float    @default(0)
  paidTotal         Float?
  lastSyncedAt      DateTime @updatedAt
  items             TradeMeJobItem[]

  @@unique([shop, groupKey])
  @@index([shop, buyerEmail])
}

model TradeMeJobItem {
  id            String     @id @default(cuid())
  job           TradeMeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String
  purchaseId    String     @unique
  listingId     String?
  sku           String?
  title         String?
  quantity      Int        @default(1)
  salePrice     Float      @default(0)
  shippingPrice Float      @default(0)
  soldDate      String?
  saleChannel   String? // "store" | "auction" | "fpo"
  imageUrl      String? // Trade Me PictureHref, sanitised (lib/tradeMeImage)
  packed        Boolean    @default(false)

  @@index([jobId])
}

// Items marked packed in Pack Check. Kept separate from TradeMeJobItem on
// purpose: the sync replaces that table wholesale from the local app's
// snapshot, which would overwrite any packed flag set here. The local app
// reads these back (GET /api/trademe-sync) and marks the purchases packed /
// dispatched on its side, after which it stops pushing them.
model TradeMePackedItem {
  id         String   @id @default(cuid())
  shop       String
  purchaseId String
  groupKey   String
  packedAt   DateTime @default(now())

  @@unique([shop, purchaseId])
  @@index([shop, packedAt])
}

// Shopify orders whose package was fully scanned in Pack Check. Pack Check
// no longer fulfils orders in Shopify; it records them here instead, hides
// them from its list, and reports them to the local Trade Me app via
// GET /api/trademe-sync. Kept indefinitely: deleting a row would make a
// still-unfulfilled order reappear in Pack Check.
model PackedOrder {
  id        String   @id @default(cuid())
  shop      String
  orderId   String // Shopify order GID
  orderName String // e.g. "#6853" or "SO4392"
  packedAt  DateTime @default(now())
  // Sales-channel identity read from Shopify at pack time. Only orders whose
  // app matches TRADEME_SHOPIFY_CHANNEL_APP_ID are reported to the local app.
  channelAppId  String?
  channelHandle String?
  channelName   String?

  @@unique([shop, orderId])
  @@index([shop, packedAt])
}

// A copy of each package as it was when recorded as packed in Pack Check,
// for the "Packed" view and its undo. Trade Me items disappear from
// TradeMeJob once the local app processes them, so the contents are stored
// here as JSON (SQLite has no JSON column type).
model PackedPackage {
  id              String   @id @default(cuid())
  shop            String
  label           String
  packedAt        DateTime @default(now())
  shopifyOrderIds String // JSON array of Shopify order GIDs
  purchaseIds     String // JSON array of Trade Me purchase IDs
  snapshot        String // JSON: { customer, email, orders: [{ id, name, channel }], items: [{ sku, title, quantity, imageUrl }] }

  @@index([shop, packedAt])
}

// Append-only log of packing acknowledgements for the local Trade Me app,
// read with GET /api/trademe-sync?after=<cursor>. The autoincrement id gives
// a strict order with no timestamp ties; the cursor is built from it. Never
// pruned. "unpacked" events record an undo from Pack Check's Packed view.
model PackEvent {
  id         Int      @id @default(autoincrement())
  shop       String
  kind       String // "trademe_purchase" | "shopify_order"
  action     String // "packed" | "unpacked"
  packageId  String?
  // kind = trademe_purchase
  purchaseId String?
  groupKey   String?
  quantity   Int?
  // kind = shopify_order
  orderId    String?
  orderName  String?
  lineItems  String? // JSON: [{ lineItemId, sku, quantity, tradeMePurchaseId }]
  occurredAt DateTime @default(now())

  @@index([shop, id])
}
